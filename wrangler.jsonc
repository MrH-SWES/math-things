{
  "name": "math-things-app",
  "main": "./worker/app-bootstrap.mjs",
  "compatibility_date": "2026-10-16",
  "routes": [
    {
      "pattern": "app.maththingsedtech.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/apps/teaching-table",
      "/apps/teaching-table/*"
    ]
  }
}
